# Supabase — client-safe (exposed to the browser; the anon key is safe by design,
# all access control is enforced server-side via RLS policies)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase ─── server-only. NEVER expose to the browser or commit real values.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Owner bootstrap (scripts/bootstrap-owner.mjs) — local only, never commit real password
# OWNER_EMAIL=ravikisan1814@gmail.com
# OWNER_PASSWORD=your-owner-password

# AI providers — server-only





AGNES_API_KEY=sk-your-agnes-key-here

# Default LLM provider when "provider" is omitted (/api/ai/generate)
AI_DEFAULT_PROVIDER=agnes

# Content migration (scripts/migrate-content.mjs) — optional overrides
# MIGRATE_SOURCE_DIRS=../ravikishan/migrated-content,../ravikishan/backend/content,../ravikishan/backend/prisma/import-data/content,../ravikishan/backend-class12-test/content
# MIGRATE_TARGET_EXAM_GROUP= (leave unset for auto-detect per source)
# MIGRATE_SOURCE_CLASSES=class-11,class-11e,class-12
